{
  "cleanUrls": false,
  "headers": [
    {
      "source": "/assets/models/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "model/gltf-binary"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/assets/environment/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/vnd.radiance"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
